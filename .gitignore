/target
**/target
**/test_snapshots
.DS_Store
.env
.env.*
!.env.example
node_modules/
dist/
# deploy/deploy.sh testnet writes deployments/testnet.json fresh every
# run and it is committed (no secret key ever appears in it; see
# deploy/deploy.sh's own header). deployments/testnet-demo-asset.json
# is the same category (public contract/asset/address fields only, no
# secret), committed so deploy/extend-ttl.sh can read the DEMOUSD
# holder's address from a Railway container that never ran
# deploy/demo-asset-trigger.sh locally. deployments/testnet-demo.json
# is the same category again: deploy/deploy.sh testnet-demo writes it,
# deploy/demo/scenario.sh reads it, and nothing in it is secret either
# (same public contract/asset/address fields, my own throwaway
# testnet-demo identities only). Everything else under deployments/
# (ad hoc local scratch, e.g. deploy/post-demo-signals.sh's own inputs
# record) stays ignored.
deployments/*.json
!deployments/testnet.json
!deployments/testnet-demo-asset.json
!deployments/testnet-demo.json

# Sylox landing page (web/landing/_moodboard is reference-only, never shipped)
web/landing/_moodboard/
web/landing/.next/
web/landing/out/
web/landing/node_modules/
web/landing/tsconfig.tsbuildinfo
# Playwright's own run output (e2e/visual-regression.spec.ts +
# e2e/accessibility.spec.ts + e2e/docs-links.spec.ts) - transient per-run
# artifacts, not the committed baseline snapshots under
# e2e/*.spec.ts-snapshots/, which stay tracked.
web/landing/test-results/
web/landing/playwright-report/

# Sylox app. lib/contracts/*/src is generated but committed (see
# web/app/README.md); only its own node_modules/out is ignored, same
# as any other dependency.
web/app/.next/
web/app/out/
web/app/node_modules/
web/app/tsconfig.tsbuildinfo
web/app/lib/contracts/*/node_modules/
web/app/lib/contracts/*/out/

web/shared/ui/node_modules/

# Sylox docs (Fumadocs). Same ignore convention as every other
# Next.js workspace here. The generated contract reference page
# itself (content/docs/contract-reference.mdx - no ".generated" in
# the filename, since Fumadocs derives this page's URL from it) IS
# committed - see web/docs/scripts/generate-contract-reference.mjs's
# own doc comment and CI's drift check, same convention as
# packages/sdk/src/networks.generated.ts.
web/docs/.next/
web/docs/out/
web/docs/node_modules/
web/docs/tsconfig.tsbuildinfo
